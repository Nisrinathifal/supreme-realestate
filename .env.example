# Public site URL, used for canonical, hreflang, sitemap and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (lib/mail). MAIL_PROVIDER=mock logs to the server console (development only; refused in production).
# MAIL_PROVIDER=http posts { from, to, reply_to, subject, text } as JSON to MAIL_PROVIDER_URL with a bearer MAIL_PROVIDER_API_KEY
# (a transactional provider with EU processing, PRD §9.2). Recipients per subject; MAIL_TO_OVERIG is the fallback.
MAIL_PROVIDER=mock
MAIL_ALLOW_MOCK=
MAIL_PROVIDER_URL=
MAIL_PROVIDER_API_KEY=
MAIL_FROM=
MAIL_TO_SAMENWERKING=
MAIL_TO_PERS=
MAIL_TO_JURIDISCH=
MAIL_TO_OVERIG=

# Set to 1 to allow a production build while marked placeholders remain (never on the live site).
ALLOW_PLACEHOLDERS=
